# Token de tu cuenta personal de Claude (Pro/Max). Se genera con:  claude setup-token
# Sustituye a la ANTHROPIC_API_KEY del curso: no escribas una clave de API aquí.
CLAUDE_CODE_OAUTH_TOKEN=
# Modelo que usan todos los agentes (alias o identificador completo)
MODEL=claude-sonnet-5-5
# Tope de gasto por llamada a Claude Code, en dólares (equivalente informativo con la cuenta personal)
PRESUPUESTO_USD=3

# ===== Reto M4 · API de producción (produccion/) =====
# --- Observabilidad: LangSmith (smith.langchain.com -> Settings -> API Keys) ---
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=m4-fabrica-produccion
NIVEL_LOG=INFO

# --- Seguridad: API keys de los clientes, formato rol:llave separadas por coma ---
# Roles: cliente (genera criterios y ve métricas), lector (solo métricas). Genera llaves con:
#   python -c "import secrets; print('fab_cli_' + secrets.token_urlsafe(24))"
API_KEYS=
LIMITE_POR_MINUTO=30
MAX_CARACTERES_HISTORIA=6000

# --- Ruteo de modelos (optimización de costos) ---
MODELO_CLASIFICADOR=claude-haiku-5-5
MODELO_ANALISTA=claude-sonnet-5-5
MODELO_DISENADOR=claude-haiku-5-5
MODELO_RESPALDO=claude-sonnet-5-5
# Estrategias: ponlas en false para medir el baseline
CACHE_ACTIVO=true
RUTEO_ACTIVO=true
CONTEXTO_RECORTADO=true
CACHE_TTL_S=86400

# --- Capacidad y resiliencia ---
MAX_CONCURRENCIA=4
MAX_EN_COLA=8
TIMEOUT_S=240
MAX_REINTENTOS_LLM=2

# --- Exposición pública con ngrok (dashboard.ngrok.com -> Your Authtoken) ---
NGROK_AUTHTOKEN=

# --- Solo pruebas/CI: respuestas deterministas sin llamar al modelo ---
LLM_FALSO=false
