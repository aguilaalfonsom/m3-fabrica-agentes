# Token de tu cuenta personal de Claude (Pro/Max). Se genera con:  claude setup-token
# Sustituye a la ANTHROPIC_API_KEY del curso: no escribas una clave de API aquí.
CLAUDE_CODE_OAUTH_TOKEN=
# Modelo que usan todos los agentes (alias o identificador completo)
MODEL=claude-sonnet-5-5
# Tope de gasto por llamada a Claude Code, en dólares (equivalente informativo con la cuenta personal)
PRESUPUESTO_USD=3
